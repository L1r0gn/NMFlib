    1.5081054244145298, 1.1809885420518018, 1.2921159432203415, 0.8719603036618863,
    1.6757448377397959, 2.0089576981388673, 2.0904442126500458, 2.056928414154271,
    1.36590702942654, 0.8990477069705677, 2.0547146190843004, 1.549699663453081,
    2.0739748722287965, 1.0738546577482337, 1.3756215971018522, 0.9301313649405322,
    1.561686225076542, 1.5899060875012174, 1.3884709834077555, 1.228822483849266,
    1.7329394581042232, 1.005098610248451, 1.6155708588403008, 0.7901582308711886,
    1.5377380131409086, 1.6114662247220575, 1.9544224042374254, 1.8938674780307991,
    1.3375764974734803, 1.053451305948933, 1.874368769254329, 1.1335246330436952,
    2.05857459419293, 1.042161911624605, 1.2393945175013088, 1.0220113451528223,
    1.5870042163479676, 1.2805013408382422,
  ])
  let model = @nmf.NMF::new(
    @nmf.NMFConfig::new(
      n_components=4,
      solver=@nmf.Solver::MU,
      loss=@nmf.Loss::Frobenius,
      init=@nmf.Init::Random,
      max_iter=500,
      tol=1.0e-6,
      seed=42UL,
      l1_reg=0.05,
      l2_reg=0.1,
    ),
  )
  match model.fit(v) {
    Ok(_) => ()
    Err(e) => abort("fixture fit failed: \{e}")
  }
  let w = unwrap_matrix(model.w())
  let h = unwrap_matrix(model.h())
  assert_eq(w.rows(), 30)
  assert_eq(w.cols(), 4)
  assert_eq(h.rows(), 4)
  assert_eq(h.cols(), 20)
  for i in 0..<w.rows() {
    for j in 0..<w.cols() {
      let x = unwrap_double(w.get(i, j))
      assert_true(x >= 0.0 && x < inf())
    }
  }
  for i in 0..<h.rows() {
    for j in 0..<h.cols() {
      let x = unwrap_double(h.get(i, j))
      assert_true(x >= 0.0 && x < inf())
    }
  }
  let j = unwrap_double(model.loss_value())
  let ref_j = 9.485983486829204
  assert_true((j - ref_j).abs() / ref_j <= 0.05)
  let rec = unwrap_double(model.reconstruction_error(v))
  let ref_rec = 1.250477568249473
  assert_true((rec - ref_rec).abs() / ref_rec <= 0.05)
}

