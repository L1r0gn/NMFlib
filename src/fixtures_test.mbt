    1.9238115803636295, 2.332212243726268, 1.9170084972771877, 1.7546684566987276,
    1.3174045385767055, 1.8367547888241682, 1.7447708205087324, 1.015506932193979,
    0.8558206775696645, 2.1631101761542673, 1.364563516106309, 1.811059181432693,
    2.2699605625976065, 1.807699754440339, 1.3797959738627932, 1.2610790387787405,
    2.558849527250487, 2.0006152372946504, 1.9436073874678355, 1.4664274611849382,
    1.5218643893539907, 1.0696492767128747, 1.4119998206392597, 1.5057528224000938,
    1.417702160649249, 1.8720837828752686, 2.1004896236130666, 1.884014023009576,
    1.3847983258433678, 1.449645267792361, 1.1329839803430388, 1.2890084290985069,
    0.934665705325169, 1.0343095830097448, 1.943124366197778, 1.1695439050385152,
    1.5571652220808698, 1.8762223277811643, 1.277472065044702, 1.210492608168115,
    1.196352740639705, 2.090752672692519, 1.9577932726317897, 1.7755657951088928,
    1.7566245800163744,
  ])
  let model = @nmf.NMF::new(
    @nmf.NMFConfig::new(
      n_components=5,
      solver=@nmf.Solver::CD,
      loss=@nmf.Loss::Frobenius,
      init=@nmf.Init::Random,
      max_iter=500,
      tol=1.0e-6,
      seed=42UL,
      l1_reg=0.05,
      l2_reg=0.0,
    ),
  )
  match model.fit(v) {
    Ok(_) => ()
    Err(e) => abort("fixture fit failed: \{e}")
  }
  let w = unwrap_matrix(model.w())
  let h = unwrap_matrix(model.h())
  assert_eq(w.rows(), 40)
  assert_eq(w.cols(), 5)
  assert_eq(h.rows(), 5)
  assert_eq(h.cols(), 25)
  for i in 0..<w.rows() {
    for j in 0..<w.cols() {
      let x = unwrap_double(w.get(i, j))
      assert_true(x >= 0.0 && x < inf())
    }
  }
  for i in 0..<h.rows() {
    for j in 0..<h.cols() {
      let x = unwrap_double(h.get(i, j))
      assert_true(x >= 0.0 && x < inf())
    }
  }
  let j = unwrap_double(model.loss_value())
  let ref_j = 7.544518680049816
  assert_true((j - ref_j).abs() / ref_j <= 0.05)
  let rec = unwrap_double(model.reconstruction_error(v))
  let ref_rec = 1.0105748537015917
  assert_true((rec - ref_rec).abs() / ref_rec <= 0.05)
}

